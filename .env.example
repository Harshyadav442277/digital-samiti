DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.tech/DATABASE/auth
NEON_AUTH_COOKIE_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CRON_SECRET=GENERATE_A_SEPARATE_RANDOM_SECRET

