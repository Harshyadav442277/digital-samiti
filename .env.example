DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SAMITI_WALLET_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CRON_SECRET=GENERATE_A_SEPARATE_RANDOM_SECRET

# Set on Next.js for the Postgres ledger, or on Express for the MongoDB ledger.
# NIMIQ_MAINNET_RPC_URL=https://YOUR-NIMIQ-MAINNET-HISTORY-NODE
# NIMIQ_MAINNET_RPC_AUTH=OPTIONAL_AUTHORIZATION_HEADER_VALUE

# Optional Express + MongoDB backend (server-only)
# SAMITI_API_URL=http://127.0.0.1:4000
# SAMITI_API_SECRET=THE_SAME_SECRET_AS_THE_EXPRESS_SERVICE
